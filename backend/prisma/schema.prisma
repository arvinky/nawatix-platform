generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  password               String?
  googleId               String?   @unique
  role                   String    @default("USER") // SUPER_ADMIN, ADMIN, USER
  phone                  String?
  avatar                 String?
  organizationName       String?
  organizationDescription String?
  organizationLogo       String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  events                 Event[]         @relation("OrganizerEvents")
  orders                 Order[]         @relation("UserOrders")
  participations         Participant[]   @relation("UserParticipations")
  verifiedParticipations Participant[]   @relation("VerifiedParticipations")

  @@map("users")
}

model Event {
  id             String        @id @default(uuid())
  banner         String?
  name           String
  organizerId    String
  sportCategory  String        @default("RUNNING") // RUNNING, CYCLING, BADMINTON, etc.
  location       String
  date           DateTime
  description    String
  organizerName  String?
  organizerPhone String?
  organizerWebsite String?
  status         String        @default("OPEN") // OPEN, CLOSING_SOON, SOLD_OUT, DRAFT
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organizer      User          @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  ticketCategories TicketCategory[]
  orders         Order[]
  participants   Participant[]
  bibs           Bib[]

  @@map("events")
}

model TicketCategory {
  id          String       @id @default(uuid())
  eventId     String
  name        String       // Early Bird, Regular, VIP
  price       Float
  quota       Int
  sold        Int          @default(0)
  status      String       @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@map("ticket_categories")
}

model Voucher {
  id          String       @id @default(uuid())
  code        String       @unique
  discountType String       @default("FIXED_AMOUNT") // PERCENTAGE, FIXED_AMOUNT
  value       Float        // Percentage (e.g. 20%) or Fixed amount (e.g. 50000)
  usageLimit  Int          @default(100)
  usedCount   Int          @default(0)
  startDate   DateTime     @default(now())
  expiredDate DateTime
  status      String       @default("ACTIVE") // ACTIVE, EXPIRED, DISABLED
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orders      Order[]

  @@map("vouchers")
}

model Order {
  id              String        @id @default(uuid())
  invoice         String        @unique // e.g. INV-20260001
  userId          String
  eventId         String
  ticketCategoryId String
  voucherId       String?
  subtotal        Float
  discount        Float         @default(0)
  total           Float
  status          String        @default("PENDING") // PENDING, PAID, EXPIRED, FAILED
  paymentMethod   String        @default("Midtrans Snap")
  snapToken       String?
  snapRedirectUrl String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation("UserOrders", fields: [userId], references: [id], onDelete: Cascade)
  event           Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketCategory  TicketCategory @relation(fields: [ticketCategoryId], references: [id], onDelete: Cascade)
  voucher         Voucher?      @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  payments        Payment[]
  participant     Participant?

  @@map("orders")
}

model Payment {
  id            String   @id @default(uuid())
  orderId       String
  transactionId String?  // From Midtrans
  paymentType   String?  // e.g., bank_transfer, credit_card, qris
  grossAmount   Float
  status        String   // e.g., settlement, pending, cancel, expire
  rawResponse   String?
  createdAt     DateTime @default(now())

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Participant {
  id                 String             @id @default(uuid())
  registrationNumber String             @unique // e.g. REG-202600001
  orderId            String             @unique
  userId             String
  eventId            String
  name               String
  email              String
  phone              String?
  status             String             @default("NOT_REGISTERED_YET") // NOT_REGISTERED_YET, COMPLETED
  bibNumber          String?
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user               User               @relation("UserParticipations", fields: [userId], references: [id], onDelete: Cascade)
  event              Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  verifiedBy         User?              @relation("VerifiedParticipations", fields: [verifiedById], references: [id], onDelete: SetNull)
  bib                Bib?

  @@map("participants")
}

model Bib {
  id            String       @id @default(uuid())
  eventId       String
  participantId String?      @unique
  bibNumber     String       // e.g., 1057
  assignedAt    DateTime?
  createdAt     DateTime     @default(now())

  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@unique([eventId, bibNumber])
  @@map("bibs")
}

model OrganizationSetting {
  id              String   @id @default(uuid())
  name            String   @default("Athletix")
  logo            String?
  theme           String   @default("dark") // dark or light
  generalSettings String   @default("{}") // JSON string for customization
  updatedAt       DateTime @updatedAt

  @@map("organization_settings")
}
